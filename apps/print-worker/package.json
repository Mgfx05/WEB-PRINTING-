{
  "name": "@erb/print-worker",
  "version": "0.1.0",
  "private": true,
  "description": "ERB Print Job Worker — claims jobs from BullMQ queue and dispatches to print agents",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@erb/database": "workspace:*",
    "@erb/types": "workspace:*",
    "bullmq": "^5.30.1",
    "ioredis": "^5.4.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
